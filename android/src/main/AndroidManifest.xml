<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="de.noctunix.obdbridge">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The targetSdk 34+ declaration a `connectedDevice` foreground service needs
         alongside FOREGROUND_SERVICE itself. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only actually held when a caller opts a recording into
         ObdRecordingOptionsMessage.holdWakeLock (CxRecordingService). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Scanning for and connecting to the adapter (CxBleClient.kt). API 31+ needs the
         two dedicated Bluetooth runtime permissions below; `neverForLocation` is correct
         because this library never derives position from a BLE scan result. Pre-31 BLE
         scanning instead requires a location permission, which the host app declares if
         it wants location at all — this library does not declare one of its own. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Bluetooth is optional: both declared `required="false"` so the merged manifest's
         BLUETOOTH/BLUETOOTH_ADMIN permissions above cannot be read as implying the host
         app needs Bluetooth hardware to install or run at all. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Companion-device pairing of the adapter. Optional: without the feature the plugin falls
         back to scanning. -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE"
        tools:targetApi="31" />
    <!-- Lets the presence service start the connectedDevice recording service while the app is in
         the background. -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND"
        tools:targetApi="31" />

    <application>
        <!-- The buffered recording's foreground service. Not exported — only
             ObdApi.startRecording ever starts it. -->
        <service
            android:name="de.noctunix.obdbridge.CxRecordingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Bound by the platform when the paired adapter appears (ObdCompanionService). -->
        <service
            android:name="de.noctunix.obdbridge.ObdCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
    </application>
</manifest>
